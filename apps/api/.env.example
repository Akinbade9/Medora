NODE_ENV=development

# Server
HOST=127.0.0.1
PORT=3000

# Database: use a dedicated development database locally
MONGODB_URI=mongodb://127.0.0.1:27017/medora

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Frontend origins
WEB_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8081

# Optional, only for seed:dev: choose a unique password of 12-128 characters.
SEED_PASSWORD=
