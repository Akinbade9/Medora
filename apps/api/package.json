{
  "name": "@medora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "user:role": "tsx src/auth/set-role.ts",
    "seed:dev": "tsx src/domain/seed.ts",
    "seed:catalogue": "tsx src/catalogue/seed.ts"
  },
  "dependencies": {
    "@medora/shared-types": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "mongoose": "^9.10.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server-core": "^11.3.0",
    "supertest": "^7.2.0"
  }
}
